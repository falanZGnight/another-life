function explore(){
  advance(45);
  G.player.stamina=Math.max(0,G.player.stamina-8);
  const r=Math.random();
  if(r<.22){
    const item=pick(["สมุนไพร","ไม้","แร่เหล็ก","เนื้อ"]);
    G.inventory[item]=(G.inventory[item]||0)+1;
    G.player.skills.สำรวจ+=Math.random()<.3?1:0;
    log("สำรวจสำเร็จ พบ "+item);
    progressQuest("รวบรวมทรัพยากร");progressQuest("สำรวจพื้นที่");
  }else if(r<.44){
    log("คุณพบร่องรอยบางอย่างในพื้นที่");
    G.world.knowledge++;progressQuest("ค้นหาข้อมูล");progressQuest("สำรวจพื้นที่");
  }else if(r<.75){
    monsterEncounter();
  }else{
    const n=makeNPC();G.npcs.unshift(n);
    log("ระหว่างทางพบ "+n.name+" ซึ่งดูเหมือนมีเรื่องปิดบัง");
    showEvent("พบคนแปลกหน้า",n.name+" ดู"+n.personality+" และ"+n.motive,[
      {label:"ทักทาย",fn:()=>{n.trust+=5;log("คุณทักทาย "+n.name);}},
      {label:"เฝ้าดูห่าง ๆ",fn:()=>{if(n.secret)G.world.knowledge++;log("คุณสังเกตเห็นพฤติกรรมของ "+n.name);}},
      {label:"เดินผ่านไป",fn:()=>log("คุณไม่เข้าไปยุ่ง")}
    ]);
  }
  render();
}
function rest(){
  advance(360);
  G.player.hp=clamp(G.player.hp+35,0,G.player.maxHp);
  G.player.mp=clamp(G.player.mp+20,0,G.player.maxMp);
  G.player.stamina=100;
  log("คุณพักผ่อน ฟื้นฟู HP และมานาบางส่วน");
  render();
}
function train(){
  if(G.player.stamina<10){log("เหนื่อยเกินไป ควรพักก่อน");return;}
  advance(60);G.player.stamina-=10;
  const s=pick(Object.keys(G.player.skills));
  G.player.skills[s]++;
  G.player.xp+=5;
  log("ฝึกฝนสำเร็จ: ทักษะ"+s+" เพิ่มขึ้น");
  checkLevel();render();
}
function work(){
  advance(90);
  let pay=12+rand(12)+G.player.skills.ช่างฝีมือ;
  if(G.player.talent==="นักเจรจา")pay+=4;
  G.player.gold+=pay;
  G.world.reputation++;
  log("ทำงานทั่วไปสำเร็จ ได้ "+pay+" เหรียญ");
  progressQuest("ส่งของให้พ่อค้า");
  render();
}
function hunt(){advance(10);monsterEncounter();}
function ruin(){
  advance(60);
  if(G.world.terrain==="ซากโบราณ"||Math.random()<.4){
    if(Math.random()<.3&&G.world.knowledge<2){
      log("กับดักโบราณทำงาน คุณเสีย HP 12");
      G.player.hp=Math.max(1,G.player.hp-12);
    }else{
      const loot=pick(["ตำรา","เศษวัตถุเวท","โลหะโบราณ"]);
      G.inventory[loot]=(G.inventory[loot]||0)+1;
      G.world.knowledge++;G.world.technology++;
      G.ruinFinds++;
      log("ค้นพบ "+loot+" จากซากอารยธรรมโบราณ");
      progressQuest("ค้นหาข้อมูล");
    }
    if(Math.random()<.3)monsterEncounter(true);
  }else{
    log("คุณพบร่องรอยซากโบราณ แต่ยังเข้าไปไม่ถึงแกนกลาง");
    G.world.knowledge++;
  }
  render();
}
function travel(){
  advance(180);
  const r=pick(REGIONS);
  G.world.region=r.name;G.world.terrain=r.terrain;G.world.danger=r.danger;
  if(!G.world.visited.includes(r.name))G.world.visited.push(r.name);
  log("เดินทางมาถึง "+r.name+" ภูมิประเทศ: "+r.terrain);
  progressQuest("สำรวจพื้นที่");
