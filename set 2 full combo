      {label:"สัญญาคุ้มครอง (จ่าย 15 เหรียญ)",fn:()=>{
        if(G.player.gold>=15&&n.personality!=="เจ้าเล่ห์"){G.player.gold-=15;G.contracts.push({npcId:n.id,type:"คุ้มครอง",until:G.world.day+2});log(n.name+" ตกลงช่วยคุ้มครองชั่วคราว");}
        else{log("สัญญาไม่สำเร็จ อาจเพราะเงินไม่พอหรืออีกฝ่ายไม่ไว้ใจ");}
      }},
      {label:"ยกเลิก",fn:()=>log("คุณยังไม่ทำสัญญา")}
    ]);
}
function potion(){
  if((G.inventory["ยาฟื้นฟู"]||0)<=0){log("ไม่มียาฟื้นฟู");return;}
  G.inventory["ยาฟื้นฟู"]--;G.player.hp=clamp(G.player.hp+35,0,G.player.maxHp);
  G.player.mp=clamp(G.player.mp+5,0,G.player.maxMp);
  log("ใช้ยาฟื้นฟู HP เพิ่มขึ้น");
  render();
}
function pet(){
  if(!G.pet){
    if(G.player.gold<20){log("ต้องมีเงิน 20 เหรียญเพื่อรับเลี้ยงสัตว์");return;}
    G.player.gold-=20;G.pet={name:pick(["มะลิ","ถ่าน","เมฆ","ถั่ว","เงา"]),kind:pick(["แมวป่า","สุนัขเดินทาง","จิ้งจอกเวท"]),bond:1};
    log("คุณรับเลี้ยง "+G.pet.kind+" ชื่อ "+G.pet.name);
  }else{
    G.pet.bond++;G.player.stamina=clamp(G.player.stamina+5,0,100);
    log("คุณใช้เวลากับ "+G.pet.name+" ความผูกพันเพิ่มขึ้น");
  }
  render();
}

/* =========================
   Race evolution, rendering
   ========================= */
function maybeEvolve(){
  const p=G.player;
  if(p.level>=5&&!p.perks.includes("วิวัฒนาการ")){
    p.perks.push("วิวัฒนาการ");
    if(p.race==="มนุษย์")p.race="มนุษย์ผู้ตื่นรู้";
    else if(p.race==="เอลฟ์")p.race="เอลฟ์โบราณ";
    else if(p.race==="คนแคระ")p.race="คนแคระรูน";
    else if(p.race==="เผ่ามาร")p.race="มารชั้นสูง";
    else if(p.race==="มนุษย์สัตว์")p.race="มนุษย์สัตว์กลายพันธุ์";
    p.maxHp+=10;p.maxMp+=10;p.hp=p.maxHp;p.mp=p.maxMp;
    log("วิวัฒนาการเผ่า! คุณเปลี่ยนเป็น "+p.race);
  }
}
function render(){
  if(!G)return;
  maybeEvolve();
  const p=G.player,w=G.world;
  $("heroTitle").textContent=p.name+" · Lv."+p.level;
  $("heroMeta").textContent="เผ่า "+p.race+" · บุคลิก "+p.personality+" · พรสวรรค์ "+p.talent;
  $("location").textContent=w.region;
  $("worldMeta").textContent="วันที่ "+w.day+" · "+String(w.hour).padStart(2,"0")+":"+String(w.minute).padStart(2,"0")+" · "+w.season+" · ปี "+w.year;
  $("hpText").textContent=p.hp+"/"+p.maxHp;
  $("mpText").textContent=p.mp+"/"+p.maxMp;
  $("hpBar").style.width=(p.hp/p.maxHp*100)+"%";
  $("mpBar").style.width=(p.mp/p.maxMp*100)+"%";
  $("atkText").textContent=p.atk+" / DEF "+p.def;
  $("goldText").textContent=p.gold;
  $("conditionTags").innerHTML=[
    "ความอึด "+p.stamina+"/100","ชื่อเสียง "+w.reputation,
    "ความรู้ "+w.knowledge,"เทคโนโลยี "+w.technology,
    "สัตว์เลี้ยง "+(G.pet?G.pet.name:"ยังไม่มี")
  ].map(t=>'<span class="tag">'+esc(t)+'</span>').join("");
  $("skills").innerHTML=Object.entries(p.skills).map(([k,v])=>'<div>'+esc(k)+' <strong>'+v+'</strong></div>').join("");
  $("npcs").innerHTML=G.npcs.filter(n=>n.alive).slice(0,8).map(n=>
    '<div class="quest"><strong>'+esc(n.name)+'</strong> <span class="tag">'+esc(n.personality)+'</span><div class="muted">แรงจูงใจ: '+esc(n.motive)+' · ความไว้ใจ '+n.trust+'</div>'+
    (n.recruited?'<span class="good">ร่วมเดินทาง</span>':'')+'</div>').join("")||'<p class="muted">ยังไม่มีคนรู้จัก</p>';
  $("quests").innerHTML=G.quests.slice(0,10).map(q=>
    '<div class="quest"><strong>'+esc(q.title)+'</strong>'+
    '<div>'+esc(q.description)+'</div><div class="muted">ความคืบหน้า '+q.progress+'/'+q.goal+' · กำหนดวันที่ '+q.deadline+' · รางวัล '+q.reward+'</div>'+
    (q.done?'<span class="good">สำเร็จ</span>':q.failed?'<span class="bad">ล้มเหลว</span>':'')+'</div>').join("")||'<p class="muted">ยังไม่มีเควส</p>';
  $("inventory").innerHTML=Object.entries(G.inventory).filter(([,v])=>v>0).map(([k,v])=>'<div>'+esc(k)+' × '+v+'</div>').join("")||'<p class="muted">กระเป๋าว่างเปล่า</p>';
  $("worldInfo").innerHTML=
    '<div>ภูมิประเทศ: <strong>'+esc(w.terrain)+'</strong> · ระดับอันตราย '+w.danger+'</div>'+
    '<div>สถานที่ที่เคยไป: '+w.visited.map(esc).join("、")+'</div>'+
    '<div>ศาสนา/พิธี: '+w.faith+' · การเมือง: '+w.politics+' · ความรู้: '+w.knowledge+' · เทคโนโลยี: '+w.technology+'</div>'+
    '<div>การค้นพบซากโบราณ: '+G.ruinFinds+' · สัญญาที่ยังมีผล: '+G.contracts.filter(c=>c.until>=w.day).length+'</div>'+
    '<div>ข่าวลือ: '+(w.rumors.length?w.rumors.map(esc).join(" / "):"ยังไม่มีข่าวลือสำคัญ")+'</div>';
  $("log").innerHTML=G.log.slice(0,30).map(e=>'<div class="log-entry"><small>วันที่ '+e.day+' · '+String(e.hour).padStart(2,"0")+':00</small><div>'+esc(e.text)+'</div></div>').join("");
  $("log").scrollTop=0;
}
function handleAction(action){
  if(!G)return;
  switch(action){
    case "explore":explore();break;
    case "rest":rest();break;
    case "train":train();break;
    case "work":work();break;
    case "hunt":hunt();break;
    case "ruin":ruin();break;
    case "travel":travel();break;
    case "talk":talkNPC();break;
    case "social":socialize();break;
    case "craft":craft();break;
    case "pray":pray();break;
    case "market":market();break;
    case "facility":facility();break;
    case "research":research();break;
    case "contract":contract();break;
    case "potion":potion();break;
    case "pet":pet();break;
    case "quest":addQuest();break;
    case "save":saveGame();break;
    case "load":loadGame();break;
    case "export":exportSave();break;
    case "import":importSave();break;
  }
}

/* =========================
   Save / load / import / export
   ========================= */
function saveGame(){
  try{
    localStorage.setItem(SAVE_KEY,JSON.stringify(G));
    log("บันทึกเกมลงเบราว์เซอร์แล้ว");
    render();toast("บันทึกเกมแล้ว");
  }catch(e){toast("บันทึกไม่สำเร็จ: "+e.message);}
}
function loadGame(){
  try{
    const raw=localStorage.getItem(SAVE_KEY);
    if(!raw){toast("ไม่พบเซฟในเบราว์เซอร์นี้");return;}
    const data=JSON.parse(raw);
    if(!data||data.version!==2||!data.player||!data.world)throw new Error("รูปแบบเซฟไม่ถูกต้อง");
    G=data;pendingChoice=null;
    $("creation").style.display="none";$("game").style.display="block";
    $("eventText").textContent="โหลดเกมสำเร็จ เลือกการกระทำเพื่อเดินทางต่อ";
    $("eventChoices").innerHTML="";
    log("โหลดเกมสำเร็จ");render();toast("โหลดเกมแล้ว");
  }catch(e){toast("โหลดเซฟไม่สำเร็จ: "+e.message);}
}
function exportSave(){
  if(!G)return;
  const blob=new Blob([JSON.stringify(G,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");a.href=url;a.download="another-life-v2-save.json";
  a.click();URL.revokeObjectURL(url);toast("ส่งออกเซฟแล้ว");
}
function importSave(){
  const input=document.createElement("input");
  input.type="file";input.accept=".json,application/json";
  input.addEventListener("change",()=>{
    const file=input.files&&input.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=()=>{
      try{
        const data=JSON.parse(reader.result);
        if(!data||data.version!==2||!data.player||!data.world||!data.inventory)throw new Error("รูปแบบเซฟไม่ถูกต้อง");
        G=data;pendingChoice=null;
        $("creation").style.display="none";$("game").style.display="block";
        $("eventText").textContent="นำเข้าเซฟสำเร็จ";
        $("eventChoices").innerHTML="";
        saveGame();render();toast("นำเข้าเซฟสำเร็จ");
      }catch(e){toast("ไฟล์เซฟไม่ถูกต้อง: "+e.message);}
    };
    reader.readAsText(file);
  });
  input.click();
}
function toast(message){
  const t=$("toast");t.textContent=message;t.style.display="block";
  setTimeout(()=>{t.style.display="none";},2500);
}

/* =========================
   Startup
   ========================= */
$("startBtn").addEventListener("click",createGame);
$("loadStartBtn").addEventListener("click",()=>{
  loadGame();
  if(!G){$("creation").style.display="block";$("game").style.display="none";}
});
document.addEventListener("click",e=>{
  const b=e.target.closest("[data-action]");
  if(b)handleAction(b.dataset.action);
});
</script>
