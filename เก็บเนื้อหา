        else{state.hero.reputation-=1;say("เขาไม่พอใจและจากไป")}
      }},
      {label:"ปฏิเสธและเฝ้าระวัง",detail:"ไม่มีค่าใช้จ่าย",run:()=>say("คุณไม่ไว้ใจคนแปลกหน้าและเก็บสัมภาระให้มิดชิด")}
    ]});
}
function meetNPC(){
  const names=["อาเรน","มีรา","เซริน","โทวา","เคล"];
  const motives=["พ่อค้า","นักสำรวจ","ผู้ลี้ภัย","นักล่าสมบัติ","คนรับจ้าง"];
  const n={name:pick(names),role:pick(motives),trust:0};
  state.npcs.push(n);
  queueEvent({title:"พบ "+n.name,text:n.name+" เป็น"+n.role+"ที่อ้างว่ากำลังเดินทางผ่านเกาะนี้ ดูเหมือนเขาต้องการความช่วยเหลือ",
    choices:[
      {label:"แบ่งอาหาร",detail:"ใช้ผลไม้ 1 หน่วย หากมี",run:()=>{
        if(take("berries")){n.trust+=2;state.hero.reputation+=1;say(n.name+" ซาบซึ้งและสัญญาว่าจะจดจำบุญคุณ")}
        else say("คุณไม่มีอาหารที่จะแบ่งให้");
      }},
      {label:"ถามข่าวสาร",detail:"อาจได้รับข้อมูลเกี่ยวกับเกาะ",run:()=>{
        if(chance(.65)){n.trust++;say(n.name+" บอกว่ามีซากโบราณอยู่บนเกาะนครที่สาบสูญ")}
        else{say(n.name+" เล่าเรื่องคลุมเครือ คุณไม่แน่ใจว่าเชื่อได้หรือไม่")}
      }},
      {label:"เดินทางต่อ",detail:"ไม่ผูกพันกับคนแปลกหน้า",run:()=>say("คุณกล่าวลาและเดินทางต่อ")}
    ]});
}
function checkQuests(){
  const inv=state.inventory,w=state.world;
  state.quests.forEach(q=>{
    if(q.done)return;
    let done=false;
    if(q.id==="survive")done=inv.cleanWater>=2&&(inv.berries+inv.rawMeat+inv.cookedMeat+inv.monsterMeat)>=2;
    if(q.id==="explore")done=w.exploreCount>=3;
    if(q.id==="island")done=w.travelled;
    if(done){q.done=true;state.hero.coins+=5;addXP(20);say("สำเร็จเควส: "+q.title+" · ได้ 5 เหรียญและประสบการณ์")}
  });
}
function die(){
  if(!state.hero.alive)return;
  state.hero.alive=false;state.world.paused=true;
  queueEvent({title:"ชีวิตนี้สิ้นสุดลง",text:"การเดินทางของคุณจบลงในหมู่เกาะแห่งนี้ แต่เรื่องราวไม่จำเป็นต้องจบตามไปด้วย",
    choices:[
      {label:"เริ่มชีวิตใหม่",detail:"สร้างตัวละครใหม่และเริ่มการเดินทางอีกครั้ง",run:()=>{document.getElementById("setupLayer").classList.add("show")}},
      {label:"กลับไปยังเซฟล่าสุด",detail:"หากมีข้อมูลบันทึกอยู่",run:()=>loadGame()}
    ]});
  say("ตัวละครเสียชีวิต");
}

/* ---------- UI rendering ---------- */
function meter(label,value,color){
  const safe=clamp(value,0,100);
  return '<div class="stat"><div class="stathead"><span>'+label+'</span><strong>'+Math.round(safe)+'/100</strong></div><div class="bar"><div class="fill" style="width:'+safe+'%;background:'+color+'"></div></div></div>';
}
function render(){
  if(!state)return;
  const h=state.hero,w=state.world,is=currentIsland();
  document.getElementById("clock").textContent="วันที่ "+w.day+" · "+timeString();
  document.getElementById("weather").textContent=w.weather;
  document.getElementById("speed").textContent=eventOpen?"หยุดเพื่อเลือก":w.paused?"หยุดเวลา":"เวลาเดินปกติ";
  document.getElementById("pauseBanner").style.display=eventOpen?"block":"none";
  document.getElementById("heroName").textContent=h.name;
  document.getElementById("heroInfo").textContent=h.race+" · "+({survival:"ผู้เอาชีวิตรอด",fighter:"นักสู้",scout:"นักสำรวจ"}[h.talent]||h.talent);
  document.getElementById("heroLevel").textContent="Lv."+h.level;
  document.getElementById("stats").innerHTML=
    meter("❤️ พลังชีวิต",h.hp/h.maxHp*100,"var(--green)")+
    meter("⚡ พลังงาน",h.stamina,"var(--blue)")+
    meter("😴 ความเหนื่อย",h.fatigue,"#d4b56e")+
    meter("🤒 ความเจ็บป่วย",h.illness,"var(--red)")+
    meter("☠️ พิษ",h.poison,"#bb8ce6");
  document.getElementById("needs").innerHTML=
    meter("ความหิว",h.hunger,"#d9a75e")+
    meter("ความกระหาย",h.thirst,"#71bce8");
  document.getElementById("xp").textContent=h.xp+" / "+(h.level*100);
  document.getElementById("xpBar").style.width=(h.xp/(h.level*100)*100)+"%";
  document.getElementById("inventory").innerHTML=Object.entries(state.inventory)
    .filter(([id,n])=>n>0&&ITEMS[id]).map(([id,n])=>'<div class="row"><span>'+ITEMS[id].icon+" "+ITEMS[id].name+'</span><strong>×'+n+'</strong></div>').join("")||'<span class="muted">กระเป๋าว่างเปล่า</span>';
  document.getElementById("islandTitle").textContent=is.name;
  document.getElementById("islandType").textContent=is.type;
  document.getElementById("islandDesc").textContent=is.desc;
  document.getElementById("islandMap").replaceChildren();
  ISLANDS.forEach(i=>{
    const b=document.createElement("button");
    b.className="island"+(i.id===w.island?" current":"");
    const top=document.createElement("span");top.className="emoji";top.textContent=i.emoji;
    const name=document.createElement("strong");name.textContent=i.name;
    const info=document.createElement("small");info.textContent=i.id===w.island?"📍 อยู่ที่นี่":"อันตราย "+i.danger+"/5";
    b.append(top,name,info);
    b.onclick=()=>{if(i.id!==w.island){queueEvent({title:"เดินทางไป "+i.name,text:"คุณจะออกเดินทางไปยัง"+i.name+"หรือไม่?",
      choices:[{label:"ออกเดินทาง",detail:"ใช้เวลาและพลังงาน",run:()=>travel(i.id)},
      {label:"อยู่ต่อ",detail:"ยังไม่ออกเดินทาง",run:()=>say("คุณอยู่บนเกาะเดิม")}]})}};
    document.getElementById("islandMap").appendChild(b);
  });
  document.getElementById("weatherDetail").textContent=w.weather;
  document.getElementById("danger").textContent=is.danger+"/5";
  document.getElementById("reputation").textContent=h.reputation;
  document.getElementById("coins").textContent=h.coins;
  document.getElementById("condition").textContent=!h.alive?"เสียชีวิต":h.hp<30?"วิกฤต":h.illness>30?"เจ็บป่วย":h.injury>30?"บาดเจ็บ":h.thirst>80?"ขาดน้ำ":h.hunger>80?"หิวโซ":"ปกติ";
  document.getElementById("skills").innerHTML=Object.entries(state.skills).map(([k,v])=>'<div class="row"><span>'+({survival:"เอาชีวิตรอด",combat:"ต่อสู้",scouting:"สำรวจ",crafting:"ประดิษฐ์",medicine:"การแพทย์"}[k]||k)+'</span><strong>Lv.'+v+'</strong></div>').join("");
  document.getElementById("quests").innerHTML=state.quests.map(q=>'<div class="tile" style="margin-bottom:8px"><strong>'+(q.done?"✅ ":"📜 ")+q.title+'</strong><p class="muted" style="margin:5px 0 0">'+q.text+'</p></div>').join("");
  renderLog();
  document.querySelectorAll("main button").forEach(b=>b.disabled=eventOpen||!h.alive);
  document.querySelector('header button').disabled=eventOpen||!h.alive;
}
function renderLog(){
  if(!state)return;
  document.getElementById("log").innerHTML=state.log.map(l=>'<p><span class="tag">วันที่ '+l.day+' · '+l.time+'</span><br>'+escapeHTML(l.text)+'</p>').join("")||'<p class="muted">ยังไม่มีบันทึก</p>';
}
function escapeHTML(s){
  return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function saveQuietly(){try{localStorage.setItem("anotherLifeV2",JSON.stringify(state))}catch(e){}}
function saveGame(){
  try{localStorage.setItem("anotherLifeV2",JSON.stringify(state));say("บันทึกเกมแล้ว")}
  catch(e){say("บันทึกไม่สำเร็จ: พื้นที่จัดเก็บอาจไม่พร้อมใช้งาน")}
}
function loadGame(){
  try{
    const raw=localStorage.getItem("anotherLifeV2");
    if(!raw){say("ไม่พบเซฟเกม");return}
    const loaded=JSON.parse(raw);
    if(loaded.version!==2||!loaded.hero||!loaded.world||!loaded.inventory)throw Error("Invalid save");
    state=loaded;eventQueue=[];eventOpen=false;
    document.getElementById("eventLayer").classList.remove("show");
    state.world.paused=false;state.hero.alive=state.hero.hp>0;
    say("โหลดเซฟเกมแล้ว");render();
  }catch(e){console.error(e);say("โหลดเซฟไม่สำเร็จหรือข้อมูลไม่ถูกต้อง")}
}
function exportSave(){
  const text=JSON.stringify(state,null,2);
  const blob=new Blob([text],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");a.href=url;a.download="another-life-v2-save.json";a.click();
  URL.revokeObjectURL(url);say("ส่งออกข้อมูลเซฟแล้ว");
}
function newGamePrompt(){document.getElementById("setupLayer").classList.add("show")}
function startNewGame(){
  const name=document.getElementById("nameInput").value.trim()||"นักเดินทาง";
  const race=document.getElementById("raceInput").value;
  const talent=document.getElementById("talentInput").value;
  state=freshState(name,race,talent);
  if(race==="เอลฟ์")state.skills.scouting++;
  if(race==="คนแคระ")state.hero.maxHp+=10,state.hero.hp+=10;
  if(race==="ลูกครึ่งอสูร")state.hero.maxHp+=15,state.hero.hp+=15;
  if(talent==="fighter")state.skills.combat+=2;
  if(talent==="scout")state.skills.scouting+=2;
  document.getElementById("setupLayer").classList.remove("show");
  document.getElementById("eventLayer").classList.remove("show");
  eventQueue=[];eventOpen=false;lastHourEvent=-1;
  say("เริ่มการเดินทางครั้งใหม่ ณ "+currentIsland().name);
  saveQuietly();render();
}
function init(){
  state=freshState();
  say("คุณตื่นขึ้นมาบนชายฝั่งที่ไม่รู้จัก พร้อมเสบียงเพียงเล็กน้อย");
  render();
  document.getElementById("setupLayer").classList.add("show");
  timer=setInterval(tick,2500);
}
init();
</script>
