/* ทุกเหตุการณ์สำคัญใช้คิวกลาง และล็อกเวลาโลกจนเลือกคำตอบ */
function queueEvent(event){
  eventQueue.push({...event,serial:++eventSerial});
  if(!eventOpen)showNextEvent();
}
function showNextEvent(){
  if(!eventQueue.length){eventOpen=false;render();return}
  eventOpen=true;state.world.paused=true;
  const e=eventQueue.shift();
  document.getElementById("eventTitle").textContent=e.title;
  document.getElementById("eventText").textContent=e.text;
  const box=document.getElementById("eventChoices");box.replaceChildren();
  e.choices.forEach((choice,index)=>{
    const b=document.createElement("button");b.className="choice";
    const strong=document.createElement("strong");strong.textContent=(index+1)+". "+choice.label;
    const small=document.createElement("small");small.textContent=choice.detail||"ผลลัพธ์ยังไม่ชัดเจน";
    b.append(strong,small);
    b.onclick=()=>{
      if(b.disabled)return;
      box.querySelectorAll("button").forEach(btn=>btn.disabled=true);
      try{if(choice.run)choice.run()}catch(err){console.error(err);say("เกิดข้อผิดพลาดในผลลัพธ์เหตุการณ์")}
      state.stats.events++;eventOpen=false;
      document.getElementById("eventLayer").classList.remove("show");
      render();
      if(!state.hero.alive)return;
      if(eventQueue.length){showNextEvent()}
      else{state.world.paused=false;render()}
      saveQuietly();
    };
    box.appendChild(b);
  });
  document.getElementById("eventLayer").classList.add("show");
  render();
}

