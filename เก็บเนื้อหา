
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Another Life V2 — Beyond the Archipelago</title>
<style>
:root {
  color-scheme: dark;
  --bg:#10151c; --panel:#1a2430; --line:#354657;
  --text:#e9f0f5; --muted:#9eafbe; --gold:#e7c477;
  --green:#82c99a; --red:#e98484; --blue:#82c9e8;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font:15px/1.6 system-ui,"Segoe UI",sans-serif}
button,input,select{font:inherit}
button{background:#293b4c;color:var(--text);border:1px solid #496174;
border-radius:8px;padding:9px 12px;cursor:pointer;transition:.15s}
button:hover:not(:disabled){background:#3a5268;border-color:var(--gold)}
button:disabled{opacity:.4;cursor:not-allowed}
header{padding:15px 20px;border-bottom:1px solid var(--line);
background:#131c25;display:flex;justify-content:space-between;
align-items:center;gap:12px;flex-wrap:wrap}
h1,h2,h3,p{margin-top:0}
h1{font-size:23px;color:var(--gold);margin-bottom:0}
h2{font-size:18px;color:var(--gold);margin-bottom:10px}
h3{font-size:15px;margin-bottom:6px}
small,.muted{color:var(--muted)}
main{max-width:1450px;margin:auto;padding:16px;
display:grid;grid-template-columns:270px minmax(0,1fr) 300px;gap:14px}
.panel{background:var(--panel);border:1px solid var(--line);
border-radius:12px;padding:14px;min-width:0}
.stack{display:grid;gap:12px;align-content:start}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.wrap{display:flex;gap:7px;flex-wrap:wrap}
.stat{margin:10px 0}
.stathead{display:flex;justify-content:space-between;gap:8px;font-size:13px}
.bar{height:7px;background:#0e141b;border-radius:10px;overflow:hidden;margin-top:5px}
.fill{height:100%;border-radius:10px;background:var(--green);transition:width .2s}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.tile{border:1px solid var(--line);border-radius:9px;padding:10px;background:#17212b}
.tile button{width:100%;margin-top:7px}
.island-map{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.island{min-height:108px;text-align:left;display:flex;flex-direction:column;
justify-content:space-between;background:#192d38}
.island.current{border-color:var(--gold);background:#354333}
.island .emoji{font-size:25px}
.island strong{font-size:13px}
.log{max-height:240px;overflow:auto;font-size:13px}
.log p{margin:0 0 8px;padding-bottom:7px;border-bottom:1px solid #2c3945}
.tag{display:inline-block;border:1px solid #475b6b;border-radius:6px;
padding:2px 7px;color:var(--muted);font-size:12px;margin:2px}
.gold{color:var(--gold)}.good{color:var(--green)}.bad{color:var(--red)}
#eventLayer,#setupLayer{position:fixed;inset:0;background:#05090edb;
display:none;align-items:center;justify-content:center;padding:16px;z-index:20}
#eventLayer.show,#setupLayer.show{display:flex}
.modal{width:min(650px,100%);max-height:90vh;overflow:auto;
background:#19232e;border:1px solid #627589;border-radius:15px;
padding:22px;box-shadow:0 25px 100px #000b}
.modal h2{font-size:22px}
.choice{display:block;width:100%;text-align:left;margin-top:9px;padding:12px}
.choice small{display:block;margin-top:4px}
#pauseBanner{display:none;color:var(--red);font-weight:bold}
footer{text-align:center;color:var(--muted);font-size:12px;padding:12px}
input,select{background:#111a23;color:var(--text);border:1px solid var(--line);
border-radius:7px;padding:9px;width:100%;margin:4px 0 12px}
@media(max-width:1000px){main{grid-template-columns:1fr 1fr}
main>.stack:last-child{grid-column:1/-1}}
@media(max-width:620px){main{grid-template-columns:1fr;padding:9px}
main>.stack:last-child{grid-column:auto}.island-map{grid-template-columns:repeat(2,1fr)}
header{padding:12px}.panel{padding:12px}}
</style>
</head>
<body>
<header>
  <div>
    <h1>Another Life V2</h1>
    <small>Beyond the Archipelago · โลกไม่รอผู้ที่ไม่พร้อม</small>
  </div>
  <div class="wrap">
    <span class="tag" id="clock">วันที่ 1 · 06:00</span>
    <span class="tag" id="weather">อากาศแจ่มใส</span>
    <span class="tag" id="speed">เวลาเดินปกติ</span>
    <button onclick="togglePause()">⏯ หยุด/เดินเวลา</button>
  </div>
</header>

<main>
  <section class="stack">
    <div class="panel">
      <h2>ตัวละคร</h2>
      <div class="row"><strong id="heroName">นักเดินทาง</strong><span class="tag" id="heroLevel">Lv.1</span></div>
      <p class="muted" id="heroInfo">มนุษย์ · ผู้รอดชีวิต</p>
      <div id="stats"></div>
      <div class="row"><span>ประสบการณ์</span><span id="xp">0 / 100</span></div>
      <div class="bar"><div class="fill" id="xpBar" style="width:0%"></div></div>
      <hr style="border-color:var(--line);margin:14px 0">
      <h3>ความต้องการพื้นฐาน</h3>
      <div id="needs"></div>
      <p class="muted">ค่าความหิวและกระหายยิ่งสูงยิ่งอันตราย</p>
    </div>
    <div class="panel">
      <h2>กระเป๋าสัมภาระ</h2>
      <div id="inventory"></div>
      <hr style="border-color:var(--line);margin:12px 0">
      <h3>การเอาชีวิตรอด</h3>
      <div class="grid2">
        <button onclick="consume('cleanWater')">ดื่มน้ำสะอาด</button>
        <button onclick="consume('berries')">กินผลไม้</button>
        <button onclick="consume('rawMeat')">กินเนื้อดิบ</button>
        <button onclick="consume('monsterMeat')">กินเนื้อมอนสเตอร์</button>
        <button onclick="consume('cookedMeat')">กินเนื้อสุก</button>
        <button onclick="rest()">พักผ่อน</button>
      </div>
      <p class="muted" style="margin-top:9px">หากไม่มีของ อาจต้องเสี่ยงหาอาหารหรือน้ำจากธรรมชาติ</p>
    </div>
  </section>

  <section class="stack">
    <div class="panel">
      <div class="row">
        <h2 id="islandTitle">เกาะผู้มาเยือน</h2>
        <span class="tag" id="islandType">ชายฝั่ง</span>
      </div>
      <p id="islandDesc">คลื่นซัดเข้าหาชายฝั่ง ท่ามกลางซากเรือที่ไม่มีใครรู้ที่มา</p>
      <div class="island-map" id="islandMap"></div>
      <p class="muted" style="margin-top:10px">แต่ละเกาะมีทรัพยากรและอันตรายต่างกัน การเดินทางใช้เวลาและพลังงาน</p>
    </div>
    <div class="panel">
      <h2>ทำกิจกรรม</h2>
      <div class="grid2">
        <div class="tile"><strong>🔎 สำรวจพื้นที่</strong><p class="muted">หาเบาะแส ทรัพยากร หรือเหตุการณ์</p><button onclick="explore()">สำรวจ</button></div>
        <div class="tile"><strong>🌿 เก็บทรัพยากร</strong><p class="muted">อาหาร วัสดุ และน้ำ</p><button onclick="forage()">เก็บของ</button></div>
        <div class="tile"><strong>🪵 ตั้งแคมป์</strong><p class="muted">พักฟื้นเมื่อปลอดภัย</p><button onclick="camp()">ตั้งแคมป์</button></div>
        <div class="tile"><strong>🗡️ ล่ามอนสเตอร์</strong><p class="muted">เสี่ยงบาดเจ็บเพื่อรับรางวัล</p><button onclick="hunt()">ออกล่า</button></div>
        <div class="tile"><strong>💧 หาน้ำ</strong><p class="muted">ค้นหาน้ำตามภูมิประเทศ</p><button onclick="findWater()">ค้นหาแหล่งน้ำ</button></div>
        <div class="tile"><strong>🧭 เดินทาง</strong><p class="muted">ออกเรือไปเกาะอื่น</p><button onclick="travelPrompt()">เลือกเกาะ</button></div>
      </div>
    </div>
    <div class="panel">
      <h2>บันทึกการเดินทาง</h2>
      <div class="log" id="log"></div>
    </div>
  </section>

  <section class="stack">
    <div class="panel">
      <h2>สถานะโลก</h2>
      <div class="row"><span>สภาพร่างกาย</span><strong id="condition">ปกติ</strong></div>
      <div class="row"><span>สภาพอากาศ</span><span id="weatherDetail">แจ่มใส</span></div>
      <div class="row"><span>ภัยคุกคาม</span><span id="danger">ไม่ทราบ</span></div>
      <div class="row"><span>ชื่อเสียง</span><span id="reputation">0</span></div>
      <div class="row"><span>เหรียญ</span><span id="coins">10</span></div>
      <hr style="border-color:var(--line);margin:12px 0">
      <h3>สกิล</h3>
      <div id="skills"></div>
    </div>
    <div class="panel">
      <h2>เควส</h2>
      <div id="quests"></div>
    </div>
    <div class="panel">
      <h2>บันทึก / ตั้งค่า</h2>
      <div class="grid2">
        <button onclick="saveGame()">บันทึกเกม</button>
        <button onclick="loadGame()">โหลดเกม</button>
        <button onclick="newGamePrompt()">สร้างตัวละคร</button>
        <button onclick="exportSave()">ส่งออกเซฟ</button>
      </div>
      <p class="muted" style="margin-top:10px">เซฟในเบราว์เซอร์นี้เท่านั้น หากย้ายอุปกรณ์ให้ส่งออกข้อมูลเซฟ</p>
    </div>
  </section>
</main>
<footer>Another Life V2 · Single-file RPG prototype · การตัดสินใจมีผลต่อโลกและผู้เล่น</footer>

<div id="eventLayer" role="dialog" aria-modal="true" aria-labelledby="eventTitle">
  <div class="modal">
    <div class="row"><span class="tag">เหตุการณ์ · เวลาโลกหยุด</span><span class="bad">⏸ PAUSED</span></div>
    <h2 id="eventTitle"></h2>
    <p id="eventText"></p>
    <div id="eventChoices"></div>
  </div>
</div>

<div id="setupLayer" role="dialog" aria-modal="true">
  <div class="modal">
    <h2>เริ่มต้นชีวิตใหม่</h2>
    <label for="nameInput">ชื่อตัวละคร</label>
    <input id="nameInput" maxlength="24" value="นักเดินทาง">
    <label for="raceInput">เผ่าพันธุ์</label>
    <select id="raceInput">
      <option value="มนุษย์">มนุษย์ — สมดุลและปรับตัวง่าย</option>
      <option value="เอลฟ์">เอลฟ์ — สำรวจและเก็บสมุนไพรเก่ง</option>
      <option value="คนแคระ">คนแคระ — ทนทานและเก็บวัสดุเก่ง</option>
      <option value="ลูกครึ่งอสูร">ลูกครึ่งอสูร — แข็งแกร่งแต่กินจุมากขึ้น</option>
    </select>
    <label for="talentInput">พรสวรรค์</label>
    <select id="talentInput">
      <option value="survival">ผู้เอาชีวิตรอด — หาอาหารง่ายขึ้น</option>
      <option value="fighter">นักสู้ — ต่อสู้เก่งขึ้น</option>
      <option value="scout">นักสำรวจ — สำรวจได้ของเพิ่ม</option>
    </select>
    <button style="width:100%" onclick="startNewGame()">เริ่มการเดินทาง</button>
  </div>
</div>

<script>
"use strict";

/* =========================================================
   Another Life V2 — Game Core
   ระบบใหม่ควรเชื่อมกับ state, actions, events และ world data
   ========================================================= */

const ITEMS = {
  cleanWater:{name:"น้ำสะอาด",icon:"💧",type:"drink"},
  dirtyWater:{name:"น้ำจากธรรมชาติ",icon:"🫗",type:"drink"},
  berries:{name:"ผลไม้ป่า",icon:"🫐",type:"food"},
  rawMeat:{name:"เนื้อดิบ",icon:"🥩",type:"food"},
  monsterMeat:{name:"เนื้อมอนสเตอร์",icon:"🍖",type:"food"},
  cookedMeat:{name:"เนื้อปรุงสุก",icon:"🍗",type:"food"},
  wood:{name:"ไม้",icon:"🪵",type:"material"},
  herb:{name:"สมุนไพร",icon:"🌿",type:"material"},
  stone:{name:"หิน",icon:"🪨",type:"material"},
  hide:{name:"หนังสัตว์",icon:"🦴",type:"material"},
  relic:{name:"เศษวัตถุโบราณ",icon:"🔮",type:"quest"}
};

const ISLANDS = [
  {id:"arrival",name:"เกาะผู้มาเยือน",emoji:"🏝️",type:"ชายฝั่ง",
   desc:"ชายฝั่งที่เต็มไปด้วยเศษซากเรือ มีป่าขนาดเล็กและลำธารอยู่ด้านใน",
   danger:1,water:3,food:3,wood:3,stone:1,monster:"หมาป่าชายฝั่ง"},
  {id:"forest",name:"เกาะพฤกษาลึก",emoji:"🌳",type:"ป่าทึบ",
   desc:"ป่าโบราณที่เต็มไปด้วยเถาวัลย์ ผลไม้ป่า และเสียงประหลาดจากพุ่มไม้",
   danger:2,water:2,food:5,wood:5,stone:1,monster:"หมูป่าคลั่ง"},
  {id:"volcano",name:"เกาะเพลิงดำ",emoji:"🌋",type:"ภูเขาไฟ",
   desc:"พื้นดินร้อนระอุ แร่มีค่าอยู่ใต้หิน แต่สิ่งมีชีวิตที่นี่ดุร้าย",
   danger:4,water:0,food:1,wood:1,stone:5,monster:"กิ้งก่าเพลิง"},
  {id:"mist",name:"เกาะหมอกนิรันดร์",emoji:"🌫️",type:"หมอกหนา",
   desc:"หมอกปกคลุมตลอดวัน เสียงกระซิบดังมาจากซากสิ่งก่อสร้าง",
   danger:4,water:4,food:2,wood:2,stone:2,monster:"ผู้เฝ้าหมอก"},
  {id:"reef",name:"เกาะแนวปะการัง",emoji:"🐚",type:"แนวปะการัง",
   desc:"ทะเลตื้นอุดมสมบูรณ์ มีสัตว์น้ำ เปลือกหอย และกระแสน้ำอันตราย",
   danger:2,water:1,food:5,wood:1,stone:1,monster:"ปูเกราะหนา"},
  {id:"ruins",name:"เกาะนครที่สาบสูญ",emoji:"🏛️",type:"ซากอารยธรรม",
   desc:"ซากเมืองหินซ่อนกลไกโบราณ กับดัก และสิ่งที่อาจมีค่ามากกว่าทอง",
   danger:5,water:1,food:1,wood:1,stone:4,monster:"ผู้พิทักษ์โบราณ"}
];

const DEFAULT_QUESTS = [
  {id:"survive",title:"ผู้รอดชีวิต",text:"มีน้ำสะอาด 2 หน่วยและอาหาร 2 หน่วย",done:false},
  {id:"explore",title:"โลกที่ไม่รู้จัก",text:"สำรวจพื้นที่ให้ครบ 3 ครั้ง",done:false},
  {id:"island",title:"ข้ามขอบฟ้า",text:"เดินทางไปยังเกาะอื่นอย่างน้อยหนึ่งแห่ง",done:false}
];

let state;
let timer = null;
let eventQueue = [];
let eventOpen = false;
let eventSerial = 0;
let lastHourEvent = -1;

function freshState(name="นักเดินทาง",race="มนุษย์",talent="survival"){
  return {
    version:2,
    hero:{name,race,talent,level:1,xp:0,hp:100,maxHp:100,
      stamina:100,hunger:12,thirst:10,fatigue:5,illness:0,
      poison:0,injury:0,reputation:0,coins:10,alive:true},
    world:{day:1,hour:6,minute:0,paused:false,weather:"แจ่มใส",
      island:"arrival",exploreCount:0,travelled:false,daysSurvived:0},
    inventory:{cleanWater:2,berries:2,rawMeat:0,monsterMeat:0,
      cookedMeat:1,dirtyWater:0,wood:2,herb:1,stone:0,hide:0,relic:0},
    skills:{survival:1,combat:1,scouting:1,crafting:1,medicine:1},
    quests:structuredClone(DEFAULT_QUESTS),
    discovered:[],npcs:[],log:[],flags:{},stats:{kills:0,events:0}
  };
}
function rnd(n){return Math.floor(Math.random()*n)}
function chance(p){return Math.random()<p}
function pick(a){return a[rnd(a.length)]}
function clamp(n,min,max){return Math.max(min,Math.min(max,n))}
function currentIsland(){return ISLANDS.find(i=>i.id===state.world.island)||ISLANDS[0]}
function say(text){
  state.log.unshift({day:state.world.day,time:timeString(),text});
  state.log=state.log.slice(0,80);
  renderLog();
}
function timeString(){return String(state.world.hour).padStart(2,"0")+":"+String(state.world.minute).padStart(2,"0")}
function itemCount(id){return state.inventory[id]||0}
function give(id,n=1){state.inventory[id]=(state.inventory[id]||0)+n}
function take(id,n=1){
  if(itemCount(id)<n)return false;
  state.inventory[id]-=n;
  return true;
}
function addXP(n){
  const h=state.hero;h.xp+=n;
  while(h.xp>=h.level*100){
    h.xp-=h.level*100;h.level++;h.maxHp+=8;h.hp=Math.min(h.maxHp,h.hp+18);
    say("เลเวลเพิ่มเป็น "+h.level+"! ร่างกายแข็งแกร่งขึ้น");
    queueEvent({title:"พรแห่งการเติบโต",text:"ประสบการณ์ทำให้คุณพัฒนาขึ้น คุณจะใช้โอกาสนี้อย่างไร?",
      choices:[
        {label:"ฝึกฝนร่างกาย",detail:"ฟื้นฟูพลังชีวิต 20",run:()=>{state.hero.hp=clamp(state.hero.hp+20,0,state.hero.maxHp)}},
        {label:"ฝึกสัญชาตญาณ",detail:"เพิ่มสกิลเอาชีวิตรอด",run:()=>{state.skills.survival++}},
        {label:"ฝึกสมาธิ",detail:"ลดความเหนื่อย 20",run:()=>{state.hero.fatigue=clamp(state.hero.fatigue-20,0,100)}}
      ]});
  }
}
function advanceMinutes(min){
  if(!state||!state.hero.alive)return;
  const w=state.world;
  const total=w.hour*60+w.minute+min;
  w.day+=Math.floor(total/1440);
  w.hour=Math.floor((total%1440)/60);
  w.minute=total%60;
  state.hero.hunger=clamp(state.hero.hunger+min/60*1.15,0,100);
  state.hero.thirst=clamp(state.hero.thirst+min/60*1.65,0,100);
  state.hero.fatigue=clamp(state.hero.fatigue+min/60*.75,0,100);
  if(state.hero.hunger>80)state.hero.hp-=min/60*.5;
  if(state.hero.thirst>80)state.hero.hp-=min/60*1.2;
  if(state.hero.fatigue>95)state.hero.hp-=min/60*.25;
  if(state.hero.illness>0)state.hero.hp-=min/60*.15;
  if(state.hero.poison>0){state.hero.hp-=min/60*.6;state.hero.poison=clamp(state.hero.poison-min/60*.3,0,100)}
  if(state.hero.injury>0)state.hero.hp-=min/60*.08;
  state.hero.hp=clamp(state.hero.hp,0,state.hero.maxHp);
  const oldDay=state.world.day;
  if(w.day>oldDay){state.world.daysSurvived++;say("เริ่มต้นวันที่ "+w.day+" บนหมู่เกาะ")}
  if(state.hero.hp<=0){die();return}
  checkQuests();
  render();
}
function tick(){
  if(!state||state.world.paused||eventOpen||!state.hero.alive)return;
  advanceMinutes(10);
  const hour=state.world.hour;
  if(hour!==lastHourEvent){lastHourEvent=hour;
    if(chance(.12))randomWorldEvent();
    if(chance(.05))npcEvent();
  }
}
function togglePause(){
