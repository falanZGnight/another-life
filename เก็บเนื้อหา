function forage(){
  const h=state.hero,is=currentIsland();
  if(h.stamina<8){say("เหนื่อยเกินไป ควรพักก่อน");return}
  h.stamina-=8;advanceMinutes(40);
  const bonus=h.talent==="survival"?1:0;
  const r=Math.random();
  if(r<.25+is.food*.055){give("berries",1+bonus);say("พบผลไม้ป่า "+(1+bonus)+" หน่วย")}
  else if(r<.5+is.food*.055){give("wood",1);say("เก็บไม้จากบริเวณใกล้เคียง")}
  else if(r<.67){give("herb",1);say("พบสมุนไพรป่า")}
  else if(r<.82){give("stone",1);say("พบก้อนหินที่นำไปใช้ประโยชน์ได้")}
  else{say("ไม่พบทรัพยากรที่ใช้ได้")}
  if(chance(is.danger*.035))randomWorldEvent();
  render();
}
